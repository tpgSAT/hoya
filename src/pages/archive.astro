---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import { archives } from "../data/archives";
---

<Layout title="アーカイブ">
  <section class="archive-section">
    <div class="container">
      <h1 class="page-title">アーカイブ</h1>

      <div class="archive-grid">
        {
          archives.map((item) => (
            <div class="archive-card">
              <a href={item.pdf} target="_blank" class="card-link">
                <div class="card-image-wrapper placeholder-pink">
                  <Image
                    src={item.img}
                    alt={`Hoya ${item.vol}`}
                    class="card-img"
                  />
                </div>
                <div class="card-info">
                  <span class="card-vol">{item.vol}</span>
                  <span class="card-year">{item.year}</span>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .archive-section {
    padding: 60px 0 120px 0;
    background-color: #ffffff;
    min-height: 70vh;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }
  }

  .page-title {
    font-family: "Noto Sans JP Variable", sans-serif;
    font-weight: 700;
    font-size: 2.2rem;
    color: #181818;
    margin-top: 0;
    margin-bottom: 50px;
    border-bottom: 2px solid #21824f;
    padding-bottom: 15px;
    display: inline-block;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    width: 100%;
  }

  @media (max-width: 768px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .archive-grid {
      grid-template-columns: 1fr;
      gap: 30px;
      max-width: 320px;
      margin: 0 auto;
    }
  }

  .archive-card {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .card-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1.414; /* A4比率 */
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid #eaeaea;
    transition: box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: #fafafa;
  }

  .placeholder-pink {
    background-color: #f7d6d6;
    border-color: #e5b3b3;
  }

  /* AstroのScoped CSS制約を回避するため、ラッパー経由でimgにスタイルをあてる */
  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .archive-card:hover {
    transform: translateY(-8px);
  }

  .archive-card:hover .card-image-wrapper {
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }

  .archive-card:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  .card-info {
    margin-top: 15px;
    display: flex;
    justify-content: flex-start;
    gap: 15px;
    font-family: "Noto Sans JP Variable", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #444;
    padding-left: 5px;
  }

  .card-vol {
    font-weight: 700;
  }
</style>
