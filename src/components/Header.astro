---
// Astroの画像最適化を利用するため
import { Image } from 'astro:assets';
import logo from '@assets/hoya_logo.png';
---

<header>
	<Image src={logo} alt="Hoya Logo" width="120" class="logo" />
</header>

<style>
	header {
		position: fixed;
        top: 0;
        left: 0;
        width: 100%;
		padding: 0 10px;
		height: 80px;
		display: flex;
		align-items: center;
		z-index: 999;
        background-color: #fff;
	}

	.logo {

	}

</style>