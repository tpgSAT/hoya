---
// Astroの画像最適化を利用するため
import { Image } from "astro:assets";
import logo from "@assets/hoya_logo.png";

import iconX from "../assets/footer/icon_x.svg";
import iconInstagram from "../assets/footer/icon_instagram.svg";
import iconTPG from "@assets/footer/logo_set.png";
---

<footer>
    <div id="footer-top-wrapper">
        <a href="https://tpgd.jp/"
            ><Image src={iconTPG} alt="TPG Logo" width="120" class="logo" /></a
        >
        <div id="social-media">
            <a href="https://x.com/TPGardener/"><Image src={iconX} alt="X" /></a
            >
            <a href="https://www.instagram.com/taki_plaza_gardener/"
                ><Image src={iconInstagram} alt="Instagram" /></a
            >
        </div>
    </div>

    <div id="footer-nav">
        <a href="/archive" class="nav-link">アーカイブ</a>
        <a href="/#contact-section" class="nav-link">お問い合わせ</a>
    </div>
    <p id="copyright">
        ©︎ {new Date().getFullYear()} Taki Plaza Gardener All Rights Reserved.
    </p>
</footer>

<style>
    footer {
        width: 100%;
        background-color: #1f1f1f;
        padding: 30px 0 15px 0; /* 下部余白を多く確保 */
    }

    #footer-top-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin: 20px 8vw;
    }

    #social-media {
        display: flex;
        gap: 20px;
    }

    #footer-nav {
        display: grid;
        grid-template-columns: 50% 50%;
        grid-template-rows: auto;
        margin: 40px 8vw 60px 8vw;
        gap: 15px 0; /* リンク間の縦スペースを少し空ける */
    }

    /* 画像のレスポンシブ対応（はみ出し防止） */
    #footer-nav a {
        display: inline-flex;
        align-items: center;
        max-width: 90%;
    }

    .nav-link {
        font-family: "Noto Sans JP Variable", sans-serif;
        font-weight: 400;
        font-size: 15px;
        color: #fff;
    }

    #copyright {
        text-align: center;
        font-family: "Noto Sans JP Variable", sans-serif;
        font-weight: 400;
        font-size: 12px;
        color: #fff;
        margin-top: 30px;
    }

    @media (max-width: 768px) {
        #footer-top-wrapper {
            margin: 20px 5vw;
        }

        #footer-nav {
            margin: 30px 5vw;
            gap: 10px 0;
        }
    }
</style>
